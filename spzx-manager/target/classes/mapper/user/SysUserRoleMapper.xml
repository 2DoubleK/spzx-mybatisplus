<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atguigu.spzx.manager.mapper.SysUserRoleMapper">

    <sql id="columns">

    </sql>
    <resultMap id="SysMenuResultMap" type="com.atguigu.spzx.model.entity.system.SysMenu">
        <!-- 主键映射 -->
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="menu_name" property="title"/>
        <result column="component" property="component"/>
        <result column="sort_value" property="sortValue"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>

    </resultMap>
    <!--    根据id删除用户角色-->
    <delete id="deleteByUserId">
        delete
        from sys_user_role
        where user_id = #{id}
    </delete>
    <!--    根据用户id重新分配角色-->
    <insert id="doAssign">
        insert into sys_user_role(user_id, role_id, create_time, update_time, is_deleted)
        values (#{userId}, #{roleId}, now(), now(), 0)
    </insert>
    <select id="querySysRoleByUserId" resultType="long">
        select role_id
        from sys_user_role
        where user_id = #{id}
    </select>
    <select id="findMenuByUserId" resultMap="SysMenuResultMap">
        select sm.*
        from sys_user_role sur
                 inner join sys_role_menu srm on srm.role_id = sur.role_id
                 inner join sys_menu sm on sm.id = srm.menu_id
        where sur.user_id = #{id}
    </select>
    <update id="updateSysRoleMenuIsHalf">
        update sys_role_menu srm
        set srm.is_half =1
        where menu_id = #{menuId};
    </update>
</mapper>