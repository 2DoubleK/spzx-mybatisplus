<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atguigu.spzx.order.mapper.OrderItemMapper">
    <!--    <insert id="test" useGeneratedKeys="true"  keyProperty="id">-->
    <!--    </insert>-->
    <!--    <resultMap id="orderStatistics" type="com.atguigu.spzx.model.entity.order.OrderStatistics" autoMapping="true">-->

    <!--    </resultMap>-->
        <!-- 全字段 SQL 片段（与表结构 100% 对齐） -->
        <sql id="columns">
            (
                id,
                order_id,
                sku_id,
                sku_name,
                thumb_img,
                sku_price,
                sku_num,
                create_time,
                update_time,
                is_deleted
            )
        </sql>

        <!-- XML 批量插入（全字段 + foreach） -->
        <insert id="insertBatch">
            insert into order_item
            <include refid="columns"/>
            values
            <foreach collection="list" item="item" separator=",">
                (
                #{item.id},
                #{item.orderId},
                #{item.skuId},
                #{item.skuName},
                #{item.thumbImg},
                #{item.skuPrice},
                #{item.skuNum},
                now(),
                now(),
                0
                )
            </foreach>
        </insert>
</mapper>